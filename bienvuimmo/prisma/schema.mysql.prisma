// Configuration Prisma pour MySQL (o2switch)
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

// ========================================
// SCHEMA SAAS IMMOBILIER - MVP
// ========================================

// Gestion Multi-tenant
model Agency {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  phone       String?
  address     String?
  siret       String?  @unique
  logo        String?
  plan        Plan     @default(FREE)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  properties  Property[]
  contacts    Contact[]
  mandates    Mandate[]

  @@index([email])
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

// Utilisateurs de l'agence
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  firstName   String
  lastName    String
  phone       String?
  role        Role     @default(AGENT)
  avatar      String?
  isActive    Boolean  @default(true)
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  properties  Property[]
  mandates    Mandate[]
  visits      Visit[]

  @@index([email])
  @@index([agencyId])
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

// Biens immobiliers
model Property {
  id            String         @id @default(cuid())
  reference     String         @unique
  title         String
  description   String?        @db.Text
  type          PropertyType
  transactionType String?
  status        PropertyStatus @default(AVAILABLE)
  price         Float
  surface       Float?
  rooms         Int?
  bedrooms      Int?
  bathrooms     Int?
  floor         Int?
  address       String?
  city          String?
  postalCode    String?
  latitude      Float?
  longitude     Float?
  photos        Json?
  documents     Json?
  features      Json?
  energyClass   String?
  gesClass      String?
  ghgClass      String?
  agencyId      String
  agency        Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  mandates      Mandate[]
  visits        Visit[]
  matches       Match[]

  @@index([reference])
  @@index([agencyId])
  @@index([userId])
  @@index([city])
  @@index([type])
  @@index([status])
}

enum PropertyType {
  APARTMENT
  HOUSE
  LAND
  COMMERCIAL
  PARKING
  OTHER
}

enum PropertyStatus {
  AVAILABLE
  UNDER_OFFER
  SOLD
  RENTED
  ARCHIVED
}

// Contacts (acquéreurs/vendeurs)
model Contact {
  id          String        @id @default(cuid())
  type        ContactType
  firstName   String
  lastName    String
  email       String
  phone       String
  address     String?
  city        String?
  budget      Float?
  criteria    Json?
  notes       String?       @db.Text
  source      String?
  agencyId    String
  agency      Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  visits      Visit[]
  matches     Match[]

  @@index([email])
  @@index([agencyId])
  @@index([type])
}

enum ContactType {
  BUYER
  SELLER
  TENANT
  LANDLORD
}

// Mandats
model Mandate {
  id          String       @id @default(cuid())
  reference   String       @unique
  type        MandateType
  startDate   DateTime
  endDate     DateTime
  exclusive   Boolean      @default(false)
  commission  Float
  document    String?
  status      MandateStatus @default(ACTIVE)
  propertyId  String
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agencyId    String
  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([reference])
  @@index([propertyId])
  @@index([agencyId])
  @@index([userId])
}

enum MandateType {
  SALE
  RENTAL
}

enum MandateStatus {
  ACTIVE
  EXPIRED
  COMPLETED
  CANCELLED
}

// Visites
model Visit {
  id          String       @id @default(cuid())
  date        DateTime
  duration    Int          @default(60)
  status      VisitStatus  @default(SCHEDULED)
  notes       String?      @db.Text
  feedback    String?      @db.Text
  propertyId  String
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([propertyId])
  @@index([contactId])
  @@index([userId])
  @@index([date])
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Matching IA entre biens et contacts
model Match {
  id          String       @id @default(cuid())
  score       Float
  status      MatchStatus  @default(PENDING)
  propertyId  String
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([propertyId, contactId])
  @@index([propertyId])
  @@index([contactId])
  @@index([score])
}

enum MatchStatus {
  PENDING
  CONTACTED
  INTERESTED
  NOT_INTERESTED
  VISIT_SCHEDULED
}
