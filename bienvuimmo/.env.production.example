# Configuration de production pour o2switch
# IMPORTANT : Remplacer toutes les valeurs par vos vraies valeurs

# Base de données MySQL o2switch
# Format : mysql://username:password@host:3306/database_name
# Note: o2switch ajoute automatiquement un préfixe à votre compte (ex: sc1wtgm7011_)
DATABASE_URL="mysql://sc1wtgm7011_bienvuimmo_user:VOTRE_MOT_DE_PASSE@localhost:3306/sc1wtgm7011_bienvuimmo_db"

# URL de production
NEXT_PUBLIC_SITE_URL="https://bienvuimmo.fr"
NEXTAUTH_URL="https://bienvuimmo.fr"

# Secret pour JWT (générer avec : openssl rand -base64 32)
JWT_SECRET="generer-un-secret-securise-en-production-minimum-32-caracteres"

# API
NEXT_PUBLIC_API_URL="https://bienvuimmo.fr/api"
NODE_ENV="production"

# Email (à configurer avec le service email o2switch)
SMTP_HOST="mail.bienvuimmo.fr"
SMTP_PORT="465"
SMTP_USER="contact@bienvuimmo.fr"
SMTP_PASSWORD="votre-password-email"
SMTP_FROM="BienVuImmo <contact@bienvuimmo.fr>"

# Stockage fichiers (optionnel - peut utiliser le stockage o2switch)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""

# Stripe (pour les paiements)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Google Analytics (optionnel)
NEXT_PUBLIC_GA_ID=""

# Sentry pour monitoring erreurs (optionnel)
SENTRY_DSN=""
